# =====================================================================
# VeggieAI Backend (.NET 10) — Mẫu cấu hình Biến môi trường / User Secrets
# KHÔNG lưu mật khẩu thật vào appsettings.json hoặc appsettings.Development.json
# =====================================================================

# 1. PostgreSQL Connection String (bắt buộc trong Development & Production)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=veggieai;Username=postgres;Password=CHANGE_ME;SearchPath=veggieai"
# Hoặc chỉ truyền riêng mật khẩu vào chuỗi kết nối cơ sở:
# VEGGIEAI_DB_PASSWORD="CHANGE_ME"

# 2. JWT Signing Secret (tối thiểu 32 ký tự)
Jwt__Key="REPLACE_WITH_AT_LEAST_32_BYTES_RANDOM_SECRET_KEY"
Jwt__Issuer="VeggieAI"
Jwt__Audience="VeggieAIClient"

# 3. CORS Domain triển khai thực tế (bắt buộc trên Production, phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS="https://admin.veggieai.vn,https://app.veggieai.vn"

# 4. Mã mời đăng ký quản trị nội bộ (chỉ bật khi cần khởi tạo tài khoản)
Auth__AllowInviteRegistration="false"
Auth__SuperAdminInviteCode="REPLACE_SUPERADMIN_INVITE_CODE"
Auth__ModInviteCode="REPLACE_MOD_INVITE_CODE"

# 5. Khóa Gemini AI tại Backend (tùy chọn — nếu trống hệ thống đối chiếu trực tiếp bảng Ingredient)
Ai__GeminiApiKey=""
