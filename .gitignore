appsettings.Local.json

# Node.js / ReactJS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
dist-ssr/
.env.local
.env.development.local
.env.test.local
.env.production.local

# AI Models / Heavy Binaries (Store on S3/Cloud)
*.onnx
*.pt
*.bin
